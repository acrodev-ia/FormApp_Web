@page "/course/{CourseID}"
@inject CatalogueService CatalogueService
@inject PlanningService PlanningService
@inject IJSRuntime JSRuntime

@if (course is null && !notFound)
{
    <PageHero Title="Programme" Subtitle="Chargement…" />
}
else if (notFound || course is null)
{
    <PageHero Title="Programme indisponible" Subtitle="Ce stage n’est pas publié sur le site. Contactez-nous pour plus d’informations." />
}
else
{
    var stage = course.Value.Stage;
    <PageHero Title="@stage.Intitule">
        <p>@((MarkupString)(stage.Intitule2 ?? string.Empty))</p>
    </PageHero>
    <section class="ig-section">
        <div class="container" id="element-toexportpdf">
            <div class="row g-4">
                <div class="col-lg-8">
                    <h2>Objectifs</h2>
                    <ul>
                        @if (!string.IsNullOrEmpty(stage.Objectif1)) { <li>@((MarkupString)stage.Objectif1)</li> }
                        @if (!string.IsNullOrEmpty(stage.Objectif2)) { <li>@((MarkupString)stage.Objectif2)</li> }
                        @if (!string.IsNullOrEmpty(stage.Objectif3)) { <li>@((MarkupString)stage.Objectif3)</li> }
                        @if (!string.IsNullOrEmpty(stage.Objectif4)) { <li>@((MarkupString)stage.Objectif4)</li> }
                    </ul>
                    <h2>Public</h2>
                    <div>@((MarkupString)stage.Publictype)</div>
                    <h2>Formateur</h2>
                    <div>@((MarkupString)stage.Formateur)</div>
                    <h2>Pédagogie</h2>
                    <div>@((MarkupString)stage.Pedagogie)</div>
                    <h2>Évaluation</h2>
                    <div>@((MarkupString)stage.Evaluation)</div>
                    <h2>Résultats</h2>
                    <div>@((MarkupString)stage.Resultat)</div>
                    <h2>Contenu</h2>
                    <div>@((MarkupString)stage.Contenu)</div>
                </div>
                <div class="col-lg-4">
                    @if (!string.IsNullOrEmpty(stage.DureeJour))
                    {
                        <div class="course-info d-flex justify-content-between align-items-center"><h5>Durée</h5><p>@stage.DureeJour j</p></div>
                    }
                    @if (!string.IsNullOrEmpty(stage.DureeNote))
                    {
                        <div class="course-info d-flex justify-content-between align-items-center"><h5>Durée (infos)</h5><p>@((MarkupString)stage.DureeNote)</p></div>
                    }
                    @if (!string.IsNullOrEmpty(stage.CoutStagiaire) && stage.CoutStagiaire != "0,00 €")
                    {
                        <div class="course-info d-flex justify-content-between align-items-center"><h5>Tarif HT / pers.</h5><p>@stage.CoutStagiaire</p></div>
                    }
                    @if (!string.IsNullOrEmpty(stage.CoutNote))
                    {
                        <div class="course-info d-flex justify-content-between align-items-center"><h5>Tarif (infos)</h5><p>@((MarkupString)stage.CoutNote)</p></div>
                    }
                    @if (int.TryParse(stage.NbPlacesMax, out var places) && places > 0)
                    {
                        <div class="course-info d-flex justify-content-between align-items-center"><h5>Places max.</h5><p>@places</p></div>
                    }
                    @if (!string.IsNullOrEmpty(stage.Code))
                    {
                        <div class="course-info d-flex justify-content-between align-items-center"><h5>Référence</h5><p>@stage.Code</p></div>
                    }
                </div>
            </div>
            <h2 class="mt-5">Dates</h2>
            <div class="ig-table">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Lieu</th>
                            <th>Durée</th>
                            <th>Infos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (sessions.Count == 0)
                        {
                            <tr>
                                <td colspan="4">Formation non encore programmée</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var session in sessions)
                            {
                                <tr>
                                    <td>
                                        @if (string.IsNullOrEmpty(session.Url))
                                        {
                                            @session.Date
                                        }
                                        else
                                        {
                                            <a href="@session.Url" target="_blank" rel="noopener">@session.Date</a>
                                        }
                                    </td>
                                    <td>@session.Lieu</td>
                                    <td>@session.DureePrix</td>
                                    <td>@((MarkupString)(session.Intitule2 ?? string.Empty))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="ig-actions">
            <button type="button" class="ig-btn ig-btn-primary" @onclick="PrintAll">Imprimer</button>
            <button type="button" class="ig-btn ig-btn-light" @onclick="DownloadPdf">Télécharger</button>
            <button type="button" class="ig-btn ig-btn-light" @onclick="BackPreviousPage">Retour</button>
        </div>
    </section>
}

@code {
    [Parameter] public string? CourseID { get; set; }

    private CourseRecord? course;
    private IReadOnlyList<StagePlanning> sessions = Array.Empty<StagePlanning>();
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;
        course = await CatalogueService.FindCourseAsync(CourseID);
        if (course is null)
        {
            notFound = true;
            sessions = Array.Empty<StagePlanning>();
            return;
        }

        sessions = await PlanningService.GetSessionsForCourseAsync(CourseID);
    }

    private Task PrintAll() => JSRuntime.InvokeVoidAsync("JSPrintPlanning").AsTask();
    private Task DownloadPdf() => JSRuntime.InvokeVoidAsync("JSGeneratePDF").AsTask();
    private Task BackPreviousPage() => JSRuntime.InvokeVoidAsync("JSBackPreviousPage").AsTask();
}
