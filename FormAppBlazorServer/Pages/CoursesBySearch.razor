@page "/coursesBySearch"
@page "/coursesBySearch/{SearchWord}"
@inject CatalogueService CatalogueService

<PageHero Eyebrow="Recherche" Title="Résultats" Subtitle="@Subtitle" />
<section class="ig-section">
    <div class="container">
        @if (results is null)
        {
            <p>Recherche en cours…</p>
        }
        else if (results.Count == 0)
        {
            <p>Aucun programme ne correspond à « @SearchWord ».</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var result in results)
                {
                    <div class="col-lg-4 col-md-6">
                        <CourseComponent theme="result.Theme" famille="result.Famille" stage="result.Stage" />
                    </div>
                }
            </div>
            <p class="mt-4 mb-0"><strong>@results.Count</strong> programme(s) pour le critère <strong>@SearchWord</strong>.</p>
        }
    </div>
</section>

@code {
    [Parameter] public string? SearchWord { get; set; }

    private IReadOnlyList<CourseRecord>? results;

    private string Subtitle => string.IsNullOrWhiteSpace(SearchWord)
        ? "Saisissez un mot-clé dans la barre de recherche."
        : $"Programmes correspondant à « {SearchWord} ».";

    protected override async Task OnParametersSetAsync()
    {
        results = await CatalogueService.SearchAsync(SearchWord);
    }
}
