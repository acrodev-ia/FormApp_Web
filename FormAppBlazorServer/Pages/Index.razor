@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Pb rencontré sur l'affichage du compteur
        // https://github.com/dotnet/aspnetcore/issues/22908
        // https://stackoverflow.com/questions/62379202/why-cant-i-load-any-js-after-my-blazor-server-js
        // On décale ici import du js après
        if (firstRender)
        {
            await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/assets/vendor/purecounter/purecounter.js");
        }
    }
}
