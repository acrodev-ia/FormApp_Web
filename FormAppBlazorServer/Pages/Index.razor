@page "/"
@inject IOptions<SiteOptions> SiteOptionsAccessor

<section class="ig-hero">
    <div class="container">
        <p class="ig-eyebrow">Organisme de formation · Lot</p>
        <h1>@Site.MyTitle</h1>
        <p class="lead">Donnons un sens à la formation. Depuis 2006, nous concevons et animons des actions de formation pour les entreprises, les collectivités et les salariés.</p>
        <div class="ig-hero-actions">
            <a class="ig-btn ig-btn-primary" href="courses">Voir le catalogue</a>
            <a class="ig-btn ig-btn-ghost" href="calendrier">Calendrier des sessions</a>
        </div>
    </div>
</section>

<section class="ig-section ig-stats">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="ig-stat-card">
                    <strong>437</strong>
                    <span>Clients actifs</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ig-stat-card">
                    <strong>4 861</strong>
                    <span>Personnes formées</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ig-stat-card">
                    <strong>54 718</strong>
                    <span>Heures de formation</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ig-stat-card">
                    <strong>966</strong>
                    <span>Stages réalisés</span>
                </div>
            </div>
        </div>
        <p class="text-muted mt-3 mb-0">Chiffres 2025 · 99,98 % de stagiaires satisfaits ou très satisfaits</p>
    </div>
</section>

<section class="ig-section pt-0">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <p class="ig-kicker">Pourquoi IG Formation</p>
                <h2>Une ingénierie pédagogique tournée vers vos besoins</h2>
                <p>Nous plaçons votre contexte avant nos solutions : plus de 30 ans d’expérience, 70 formateurs issus de l’entreprise, et 100 % de réalisation de nos actions de formation.</p>
                <ul class="ig-why-list">
                    <li><i class="bi bi-check-circle"></i><span>Catalogue inter-entreprises et actions sur-mesure.</span></li>
                    <li><i class="bi bi-check-circle"></i><span>Centre à Fontanes, près de Cahors, avec 4 salles équipées.</span></li>
                    <li><i class="bi bi-check-circle"></i><span>Certifications et habilitations reconnues (Qualiopi, INRS, AIPR, TOSA…).</span></li>
                </ul>
            </div>
            <div class="col-lg-6">
                <img src="ig_images/locaux01.jpg" class="img-fluid rounded-4 shadow-sm" alt="Centre de formation IG Formation à Fontanes" />
            </div>
        </div>
    </div>
</section>

<section class="ig-section pt-0">
    <div class="container">
        <p class="ig-kicker">Garanties</p>
        <h2 class="mb-4">Certifications et labels</h2>
        <div class="row g-4 ig-cert-grid">
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <a href="../ig_files/qualiopi.pdf" target="_blank" rel="noopener"><img src="ig_images/qualiopi.jpg" alt="Certification Qualiopi" /></a>
                    <div class="member-content">
                        <h3>Qualiopi</h3>
                        <p>Certification nationale de la qualité des processus mis en œuvre au titre des actions de formation, délivrée par AFNOR Certification.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/aipr.png" alt="Agréments AIPR" />
                    <div class="member-content">
                        <h3>AIPR</h3>
                        <p>Centre d’examen AIPR n° 258, agréé par le ministère de la Transition écologique depuis 2017.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/LogoCert003.png" alt="Habilitation SST" />
                    <div class="member-content">
                        <h3>SST</h3>
                        <p>Habilité par l’INRS à dispenser des formations d’acteurs SST depuis 2006.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/logoreferentiel.jpg" alt="Référentiel échafaudage de pied" />
                    <div class="member-content">
                        <h3>Échafaudage de pied (R 408)</h3>
                        <p>Habilité par l’INRS à former des acteurs échafaudage de pied depuis 2021.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/logoreferentiel.jpg" alt="Référentiel échafaudage roulant" />
                    <div class="member-content">
                        <h3>Échafaudage roulant (R 457)</h3>
                        <p>Habilité par l’INRS à former des acteurs échafaudage roulant depuis 2021.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/logotosa1.png" alt="Centre agréé TOSA" />
                    <div class="member-content">
                        <h3>Compétences informatiques</h3>
                        <p>Centre agréé TOSA® by ISOGRAD depuis 2016 pour l’évaluation et la certification des compétences bureautiques.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/logocse.png" alt="Agréments CSE" />
                    <div class="member-content">
                        <h3>CSE</h3>
                        <p>Agréé par la DREETS Occitanie pour les formations obligatoires des membres du CSE, volets santé-sécurité et économique.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/logobright.png" alt="Bright Language" />
                    <div class="member-content">
                        <h3>Bright Language</h3>
                        <p>Agent de certification Bright Language depuis 2017.</p>
                    </div>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="member">
                    <img src="ig_images/dialoguesocial.png" alt="Dialogue social" />
                    <div class="member-content">
                        <h3>Dialogue social</h3>
                        <p>Référencé par l’INTEFP au titre des formations communes au dialogue social.</p>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

@code {
    private SiteOptions Site => SiteOptionsAccessor.Value;
}
