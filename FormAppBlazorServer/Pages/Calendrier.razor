@page "/calendrier"
@inject PlanningService PlanningService
@inject IJSRuntime JSRuntime

<PageHero Eyebrow="Planning" Title="Calendrier" Subtitle="Sessions de formation à venir." />
<section class="ig-section" id="planning">
    <div class="container" id="element-toexportpdf">
        @if (plannings is null)
        {
            <p>Chargement du calendrier…</p>
        }
        else
        {
            @foreach (var planning in plannings)
            {
                @foreach (var item in planning.Themes ?? Array.Empty<ThemePlanning>())
                {
                    <h3>@item.ThemeLibelle</h3>
                    <div class="ig-table mb-4">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Formation</th>
                                    <th>Date</th>
                                    <th>Lieu</th>
                                    <th>Durée</th>
                                    <th>Infos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stage in item.Dates ?? Array.Empty<StagePlanning>())
                                {
                                    <tr>
                                        <td>
                                            @if (string.IsNullOrEmpty(stage.Id))
                                            {
                                                @stage.Texte
                                            }
                                            else
                                            {
                                                <NavLink href="@($"course/{stage.Id}")">@stage.Texte</NavLink>
                                            }
                                        </td>
                                        <td>@stage.Date</td>
                                        <td>@stage.Lieu</td>
                                        <td>@stage.DureePrix</td>
                                        <td>
                                            @((MarkupString)(stage.Intitule2 ?? string.Empty))
                                            @if (!string.IsNullOrEmpty(stage.Url))
                                            {
                                                <br />
                                                <a href="@stage.Url" rel="noopener">Financement par le CPF</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
        <div class="ig-actions">
            <button type="button" class="ig-btn ig-btn-primary" @onclick="PrintAll">Imprimer</button>
            <button type="button" class="ig-btn ig-btn-light" @onclick="DownloadPdf">Télécharger</button>
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<Rootobjectplanning>? plannings;

    protected override async Task OnInitializedAsync()
    {
        plannings = await PlanningService.GetPlanningAsync();
    }

    private Task PrintAll() => JSRuntime.InvokeVoidAsync("JSPrintPlanning").AsTask();
    private Task DownloadPdf() => JSRuntime.InvokeVoidAsync("JSGeneratePlanningPDF").AsTask();
}
