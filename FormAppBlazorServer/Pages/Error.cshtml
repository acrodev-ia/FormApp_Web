@page
@model FormAppBlazorServer.Pages.ErrorModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Erreur</title>
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/ig-theme.css" rel="stylesheet" />
</head>
<body>
    <main class="container py-5">
        <h1>Une erreur s’est produite.</h1>
        <p>La requête n’a pas pu aboutir. Vous pouvez revenir à l’accueil et réessayer.</p>
        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Identifiant de la requête :</strong> <code>@Model.RequestId</code>
            </p>
        }
        <p><a href="/">Retour à l’accueil</a></p>
    </main>
</body>
</html>
