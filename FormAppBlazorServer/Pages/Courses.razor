@page "/courses"
@page "/courses/{ThemeID}"
@page "/courses/{ThemeID}/{Famille}"
@inject CatalogueService CatalogueService
@inject IJSRuntime JSRuntime

@if (string.IsNullOrEmpty(ThemeID))
{
    <PageHero Eyebrow="Catalogue" Title="Nos formations" Subtitle="Parcourez les programmes par thématique, famille, puis stage." />
    <section class="ig-section">
        <div class="container">
            <ThemesListComponent />
        </div>
    </section>
}
else if (themes is null)
{
    <PageHero Title="Catalogue" Subtitle="Chargement du programme…" />
}
else
{
    @foreach (var theme in themes)
    {
        if (theme.IdTheme == ThemeID)
        {
            <PageHero Title="@theme.ThemeLibelle">
                <p>@((MarkupString)(theme.ThemeIntitule ?? string.Empty))</p>
            </PageHero>
            <section class="ig-section">
                <div class="container">
                    <FamillesListComponent ThemeId="@ThemeID" />
                    <div class="row g-4 mt-1">
                        @foreach (var famille in theme.Familles ?? Array.Empty<StageFamille>())
                        {
                            if (string.IsNullOrEmpty(Famille) || famille.FamilleLibelle == Famille)
                            {
                                foreach (var stage in famille.Stages ?? Array.Empty<StageDetail>())
                                {
                                    <div class="col-lg-4 col-md-6">
                                        <CourseComponent theme="theme" famille="famille" stage="stage" />
                                    </div>
                                }
                            }
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(theme.ThemeBottom))
                    {
                        <div class="mt-4">@((MarkupString)theme.ThemeBottom)</div>
                    }
                    <div class="ig-actions">
                        <button type="button" class="ig-btn ig-btn-light" @onclick="BackPreviousPage">Retour</button>
                    </div>
                </div>
            </section>
        }
    }
}

@code {
    [Parameter] public string? ThemeID { get; set; }
    [Parameter] public string? Famille { get; set; }

    private IReadOnlyList<StageTheme>? themes;

    protected override async Task OnParametersSetAsync()
    {
        themes = await CatalogueService.GetThemesAsync();
    }

    private async Task BackPreviousPage()
        => await JSRuntime.InvokeVoidAsync("JSBackPreviousPage");
}
