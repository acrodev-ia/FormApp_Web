@inject CatalogueService CatalogueService

@if (theme is null)
{
    <p>Chargement…</p>
}
else if ((theme.Familles?.Length ?? 0) > 1)
{
    <div class="row g-3 mb-4">
        @foreach (var famille in theme.Familles!)
        {
            <div class="col-lg-3 col-md-4">
                <div class="icon-box">
                    <i class="ri-bookmark-line" aria-hidden="true"></i>
                    <h3>
                        <NavLink href="@($"courses/{theme.IdTheme}/{famille.FamilleLibelle}")">@famille.FamilleLibelle</NavLink>
                    </h3>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string ThemeId { get; set; } = string.Empty;

    private StageTheme? theme;

    protected override async Task OnParametersSetAsync()
    {
        var themes = await CatalogueService.GetThemesAsync();
        theme = themes.FirstOrDefault(item => item.IdTheme == ThemeId);
    }
}
