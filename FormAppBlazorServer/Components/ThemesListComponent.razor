@inject CatalogueService CatalogueService

@if (themes is null)
{
    <p>Chargement des thématiques…</p>
}
else
{
    <div class="row g-3">
        @foreach (var theme in themes)
        {
            <div class="col-lg-3 col-md-4">
                <NavLink class="icon-box h-100 d-flex" href="@($"courses/{theme.IdTheme}")">
                    <img src="@($"ig_images/themes/{theme.IdTheme.ToUpperInvariant()}.png")"
                         onerror="this.onerror=null;this.src='ig_images/themes/empty.png';"
                         alt="" />
                    <h3>@theme.ThemeLibelle</h3>
                </NavLink>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<StageTheme>? themes;

    protected override async Task OnInitializedAsync()
    {
        themes = await CatalogueService.GetThemesAsync();
    }
}
