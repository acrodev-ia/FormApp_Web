<div class="course-item h-100">
    <div class="course-content">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <h4>@famille.FamilleLibelle</h4>
            @if (!string.IsNullOrWhiteSpace(stage.CoutStagiaire) && stage.CoutStagiaire != "0,00 €")
            {
                <p class="price">@stage.CoutStagiaire HT</p>
            }
        </div>
        <h3>
            <NavLink href="@($"course/{stage.id}")">@stage.Intitule</NavLink>
        </h3>
        <p>@((MarkupString)(stage.Intitule2 ?? string.Empty))</p>
        <div class="trainer d-flex justify-content-between align-items-center">
            <div class="trainer-profile d-flex align-items-center">
                <img src="@($"ig_images/themes/{theme.IdTheme.ToUpperInvariant()}.png")"
                     onerror="this.onerror=null;this.src='ig_images/themes/empty.png';"
                     alt="" />
                <span>@stage.Code</span>
            </div>
            <div class="trainer-rank d-flex align-items-center">
                <i class="bx bx-time" aria-hidden="true"></i>
                <span>&nbsp;@DurationLabel</span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StageDetail stage { get; set; } = default!;
    [Parameter, EditorRequired] public StageTheme theme { get; set; } = default!;
    [Parameter, EditorRequired] public StageFamille famille { get; set; } = default!;

    private string DurationLabel
        => stage.DureeJour == "1" ? "1 jour" : $"{stage.DureeJour} jours";
}
