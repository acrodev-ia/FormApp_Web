@inject IOptions<SiteOptions> SiteOptionsAccessor
@inject IJSRuntime JSRuntime

<footer id="footer">
    <div class="footer-top">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <img src="@Site.MyLogoSvg" alt="@Site.MyTitle" height="92" />
                    <p class="mt-3 mb-0">Organisme de formation professionnelle à Fontanes, près de Cahors.</p>
                </div>
                <div class="col-lg-4">
                    <h4>@Site.MyTitle</h4>
                    <p>
                        ZAE CAHORS SUD<br />
                        46230 FONTANES<br /><br />
                        <strong>Tél. </strong><a href="tel:@Site.MyPhone">@Site.MyPhone</a><br />
                        <strong>Email </strong><a href="mailto:@Site.MyMail">@Site.MyMail</a>
                    </p>
                </div>
                <div class="col-lg-4">
                    <h4>Liens utiles</h4>
                    <ul>
                        <li><i class="bx bx-chevron-right"></i> <a href="../ig_files/inscription.pdf" target="_blank" rel="noopener">Inscriptions</a></li>
                        <li><i class="bx bx-chevron-right"></i> <a href="../ig_files/cgv.pdf" target="_blank" rel="noopener">CGV</a></li>
                        <li><i class="bx bx-chevron-right"></i> <a href="../ig_files/politiqueconfidentialite.pdf" target="_blank" rel="noopener">RGPD</a></li>
                        <li><i class="bx bx-chevron-right"></i> <a href="/mentions">Mentions légales</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="container d-md-flex py-4">
        <div class="me-md-auto text-center text-md-start">
            <div class="copyright">&copy; @DateTime.Now.Year <strong>@Site.MyTitle</strong></div>
        </div>
        <div class="social-links text-center text-md-end pt-3 pt-md-0">
            <a href="https://www.facebook.com/ig.formation.cahors" target="_blank" rel="noopener" class="facebook" aria-label="Facebook"><i class="bx bxl-facebook"></i></a>
            <a href="https://www.linkedin.com/company/ig-formation-cahors/" target="_blank" rel="noopener" class="linkedin" aria-label="LinkedIn"><i class="bx bxl-linkedin"></i></a>
        </div>
    </div>
</footer>
<button type="button" class="back-to-top d-flex align-items-center justify-content-center" @onclick="ScrollTop" aria-label="Retour en haut">
    <i class="bi bi-arrow-up-short"></i>
</button>

@code {
    private SiteOptions Site => SiteOptionsAccessor.Value;

    private async Task ScrollTop()
    {
        await JSRuntime.InvokeVoidAsync("scrollToTop");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/backtotop.js");
        }
    }
}
