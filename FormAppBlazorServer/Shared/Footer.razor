<a href="@TopPage.ToLower()" class="back-to-top d-flex align-items-center justify-content-center">
    <i class="bi bi-arrow-up-short"></i>
</a>
@code {
    public string TopPage { get; set; }

    protected override void OnParametersSet()
    {
        // PageType = (this.Body.Target as RouteView)?.RouteData.PageType;
        TopPage = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).ToString().Replace(NavigationManager.ToAbsoluteUri(NavigationManager.BaseUri).ToString(), "");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/backtotop.js");
        }
    }
}